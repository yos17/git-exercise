{
  "name": "sas-studio-ai",
  "displayName": "SAS Studio AI",
  "description": "AI-powered SAS development environment with debugging, dataset viewing, and secure data anonymization",
  "version": "1.0.0",
  "publisher": "sas-studio-ai",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Data Science",
    "Machine Learning"
  ],
  "keywords": [
    "SAS",
    "Statistics",
    "Data Analysis",
    "AI",
    "Debugging",
    "Data Anonymization"
  ],
  "activationEvents": [
    "onLanguage:sas",
    "onDebugResolve:sas",
    "onCommand:sasStudioAI.connect"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sas",
        "aliases": ["SAS", "sas"],
        "extensions": [".sas", ".SAS"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sas",
        "scopeName": "source.sas",
        "path": "./syntaxes/sas.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "sasStudioAI.connect",
        "title": "SAS: Connect to Server",
        "icon": "$(plug)"
      },
      {
        "command": "sasStudioAI.disconnect",
        "title": "SAS: Disconnect",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "sasStudioAI.runCode",
        "title": "SAS: Run Selected Code",
        "icon": "$(play)"
      },
      {
        "command": "sasStudioAI.runFile",
        "title": "SAS: Run Entire File",
        "icon": "$(run-all)"
      },
      {
        "command": "sasStudioAI.viewDataset",
        "title": "SAS: View Dataset",
        "icon": "$(table)"
      },
      {
        "command": "sasStudioAI.anonymizeDataset",
        "title": "SAS: Anonymize & Export Dataset",
        "icon": "$(shield)"
      },
      {
        "command": "sasStudioAI.aiExplain",
        "title": "SAS AI: Explain Selected Code",
        "icon": "$(lightbulb)"
      },
      {
        "command": "sasStudioAI.aiGenerate",
        "title": "SAS AI: Generate Code from Description",
        "icon": "$(sparkle)"
      },
      {
        "command": "sasStudioAI.aiOptimize",
        "title": "SAS AI: Optimize Selected Code",
        "icon": "$(zap)"
      },
      {
        "command": "sasStudioAI.aiDebugHelp",
        "title": "SAS AI: Help Debug Error",
        "icon": "$(bug)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorLangId == sas",
          "command": "sasStudioAI.runCode",
          "group": "sas@1"
        },
        {
          "when": "editorLangId == sas",
          "command": "sasStudioAI.aiExplain",
          "group": "sas@2"
        },
        {
          "when": "editorLangId == sas",
          "command": "sasStudioAI.aiOptimize",
          "group": "sas@3"
        }
      ],
      "view/item/context": [
        {
          "command": "sasStudioAI.viewDataset",
          "when": "view == sasLibraries && viewItem == dataset",
          "group": "inline"
        },
        {
          "command": "sasStudioAI.anonymizeDataset",
          "when": "view == sasLibraries && viewItem == dataset",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sasStudioAI",
          "title": "SAS Studio AI",
          "icon": "resources/sas-icon.svg"
        }
      ]
    },
    "views": {
      "sasStudioAI": [
        {
          "id": "sasConnection",
          "name": "Connection"
        },
        {
          "id": "sasLibraries",
          "name": "Libraries"
        },
        {
          "id": "sasMacroVars",
          "name": "Macro Variables"
        },
        {
          "id": "sasResults",
          "name": "Results"
        }
      ]
    },
    "configuration": {
      "title": "SAS Studio AI",
      "properties": {
        "sasStudioAI.connections": {
          "type": "array",
          "default": [],
          "description": "SAS connection profiles",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string", "enum": ["soda", "iom", "viya", "ssh"] },
              "host": { "type": "string" },
              "port": { "type": "number" },
              "username": { "type": "string" }
            }
          }
        },
        "sasStudioAI.defaultConnection": {
          "type": "string",
          "default": "",
          "description": "Default connection profile name"
        },
        "sasStudioAI.ai.provider": {
          "type": "string",
          "enum": ["anthropic", "openai", "local"],
          "default": "anthropic",
          "description": "AI provider for code assistance"
        },
        "sasStudioAI.ai.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for AI provider"
        },
        "sasStudioAI.ai.model": {
          "type": "string",
          "default": "claude-sonnet-4-20250514",
          "description": "AI model to use"
        },
        "sasStudioAI.anonymization.defaultMethod": {
          "type": "string",
          "enum": ["random", "shuffle", "mask", "synthetic"],
          "default": "synthetic",
          "description": "Default data anonymization method"
        },
        "sasStudioAI.anonymization.preserveDistribution": {
          "type": "boolean",
          "default": true,
          "description": "Preserve statistical distribution when anonymizing"
        },
        "sasStudioAI.python.path": {
          "type": "string",
          "default": "python3",
          "description": "Path to Python executable"
        }
      }
    },
    "breakpoints": [
      {
        "language": "sas"
      }
    ],
    "debuggers": [
      {
        "type": "sas",
        "label": "SAS Debugger",
        "program": "./dist/debugAdapter.js",
        "runtime": "node",
        "languages": ["sas"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to SAS program to debug"
              },
              "connection": {
                "type": "string",
                "description": "Connection profile name"
              },
              "debugDataSteps": {
                "type": "boolean",
                "default": true,
                "description": "Enable DATA step debugging"
              },
              "debugMacros": {
                "type": "boolean",
                "default": true,
                "description": "Enable macro debugging"
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true,
                "description": "Stop on first executable statement"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "sas",
            "request": "launch",
            "name": "Debug SAS Program",
            "program": "${file}",
            "debugDataSteps": true,
            "debugMacros": true,
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "SAS: Debug Program",
            "description": "Debug a SAS program",
            "body": {
              "type": "sas",
              "request": "launch",
              "name": "Debug SAS",
              "program": "^\"${file}\"",
              "debugDataSteps": true,
              "debugMacros": true
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.10.0",
    "@vscode/debugadapter": "^1.64.0",
    "@vscode/debugprotocol": "^1.64.0",
    "openai": "^4.20.0"
  }
}
