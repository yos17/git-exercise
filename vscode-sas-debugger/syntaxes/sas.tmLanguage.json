{
  "name": "SAS",
  "scopeName": "source.sas",
  "fileTypes": ["sas", "SAS"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#macros" },
    { "include": "#procedures" },
    { "include": "#datastep" },
    { "include": "#functions" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.sas",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.sas",
          "match": "^\\s*\\*[^;]*;"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sas",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "variable.other.macro.sas",
              "match": "&\\w+"
            }
          ]
        },
        {
          "name": "string.quoted.single.sas",
          "begin": "'",
          "end": "'"
        }
      ]
    },
    "macros": {
      "patterns": [
        {
          "name": "keyword.control.macro.sas",
          "match": "(?i)%(MACRO|MEND|LET|IF|THEN|ELSE|DO|END|WHILE|UNTIL|PUT|GLOBAL|LOCAL|INCLUDE|SYSFUNC|EVAL|STR|NRSTR|BQUOTE|SUPERQ|SCAN|SUBSTR|INDEX|LENGTH|UPCASE|LOWCASE|COMPRESS|TRIM|LEFT|RIGHT)\\b"
        },
        {
          "name": "variable.other.macro.sas",
          "match": "&+\\w+"
        },
        {
          "name": "entity.name.function.macro.sas",
          "match": "(?i)%\\w+"
        }
      ]
    },
    "procedures": {
      "patterns": [
        {
          "name": "keyword.other.proc.sas",
          "match": "(?i)\\b(PROC|QUIT)\\b"
        },
        {
          "name": "support.function.proc.sas",
          "match": "(?i)\\b(PRINT|CONTENTS|MEANS|SUMMARY|FREQ|UNIVARIATE|CORR|REG|LOGISTIC|GLM|MIXED|GENMOD|PHREG|LIFETEST|ANOVA|TTEST|NPAR1WAY|SGPLOT|SGPANEL|SGSCATTER|GPLOT|GCHART|SQL|SORT|TRANSPOSE|DATASETS|FORMAT|CATALOG|CPORT|CIMPORT|COMPARE|APPEND|COPY|DELETE|EXPORT|IMPORT|TABULATE|REPORT|TEMPLATE|ODS|OPTMODEL|IML)\\b"
        }
      ]
    },
    "datastep": {
      "patterns": [
        {
          "name": "keyword.control.datastep.sas",
          "match": "(?i)\\b(DATA|SET|MERGE|UPDATE|BY|DROP|KEEP|RENAME|WHERE|IF|THEN|ELSE|DO|END|WHILE|UNTIL|OUTPUT|RETURN|DELETE|STOP|ABORT|RUN|CARDS|DATALINES|INFILE|INPUT|PUT|FILE|RETAIN|LENGTH|FORMAT|INFORMAT|LABEL|ATTRIB|ARRAY|LINK|GOTO|LEAVE|CONTINUE|SELECT|WHEN|OTHERWISE|FIRST|LAST|_N_|_ERROR_)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.sas",
          "match": "(?i)\\b(ABS|CEIL|FLOOR|ROUND|INT|MOD|SQRT|EXP|LOG|LOG10|LOG2|SIN|COS|TAN|ASIN|ACOS|ATAN|SINH|COSH|TANH|MAX|MIN|SUM|MEAN|STD|VAR|N|NMISS|RANGE|CSS|USS|CV|SKEWNESS|KURTOSIS|MEDIAN|MODE|PERCENTILE|QUANTILE|RANUNI|RANNOR|RANBIN|RANPOI|RAND|CAT|CATS|CATT|CATX|COMPRESS|STRIP|TRIM|LEFT|RIGHT|UPCASE|LOWCASE|PROPCASE|REVERSE|REPEAT|SUBSTR|SCAN|INDEX|INDEXC|INDEXW|FIND|FINDC|FINDW|LENGTH|LENGTHC|LENGTHM|LENGTHN|COUNT|COUNTC|COUNTW|TRANSLATE|TRANWRD|TRANSTRN|PRXMATCH|PRXCHANGE|PRXPARSE|PRXPOSN|PUT|INPUT|VNAME|VTYPE|VLENGTH|VFORMAT|VINFORMAT|VLABEL|VARNUM|VARNAME|VARTYPE|SYMGET|SYMPUT|SYMPUTX|SYMEXIST|RESOLVE|TODAY|DATE|DATETIME|TIME|MDY|YMD|DMY|DATEPART|TIMEPART|DHMS|HMS|YEAR|MONTH|DAY|WEEKDAY|QTR|WEEK|HOUR|MINUTE|SECOND|INTCK|INTNX|DATDIF|YRDIF|LAG|DIF|COALESCE|COALESCEC|IFN|IFC|CHOOSE|CHOOSEC|WHICHN|WHICHC|MISSING|CMISS|VERIFY|ANYALPHA|ANYDIGIT|ANYPUNCT|ANYSPACE|NOTALPHA|NOTDIGIT|NOTPUNCT|NOTSPACE)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.sas",
          "match": "(?i)\\b(AND|OR|NOT|EQ|NE|GT|LT|GE|LE|IN|BETWEEN|LIKE|CONTAINS|IS|NULL|MISSING|AS|FROM|INTO|ORDER|GROUP|HAVING|UNION|INTERSECT|EXCEPT|JOIN|LEFT|RIGHT|INNER|OUTER|FULL|CROSS|ON|USING|CASE|WHEN|ELSE|END|DISTINCT|ALL|ANY|EXISTS|CREATE|TABLE|VIEW|INDEX|DROP|ALTER|INSERT|UPDATE|DELETE|VALUES|SET|OPTIONS|TITLE|FOOTNOTE|LIBNAME|FILENAME|OBS|FIRSTOBS|WHERE|CLASS|VAR|MODEL|WEIGHT|FREQ|ID|STRATA|TEST|EXACT|CHISQ|MEASURES|BINOMIAL|ALPHA|CLM|STDERR|CV|NMISS|RANGE|SUM|MEAN|STD|MIN|MAX|N|USS|CSS|SKEWNESS|KURTOSIS|T|PRT|PROBT)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.sas",
          "match": "(=|\\+|-|\\*|/|\\*\\*|<>|><|<=|>=|<|>|\\^=|~=|\\|\\||!!|¦¦|\\+>)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.sas",
          "match": "\\b\\d+\\.?\\d*([eEdD][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.date.sas",
          "match": "'\\d{1,2}[A-Za-z]{3}\\d{2,4}'[dD]"
        },
        {
          "name": "constant.numeric.time.sas",
          "match": "'\\d{1,2}:\\d{2}(:\\d{2})?'[tT]"
        },
        {
          "name": "constant.numeric.datetime.sas",
          "match": "'\\d{1,2}[A-Za-z]{3}\\d{2,4}:\\d{1,2}:\\d{2}(:\\d{2})?'[dD][tT]"
        }
      ]
    }
  }
}
